# Локальный dev-сервер MkDocs Material
# Порт 8765 (8000 НЕ использовать, занят на машине Романа)
# Запуск: docker compose -f docker-compose.docs.yml up
FROM python:3.12-slim

WORKDIR /docs

COPY requirements-docs.txt .
RUN pip install --no-cache-dir -r requirements-docs.txt

EXPOSE 8765

CMD ["mkdocs", "serve", "--dev-addr=0.0.0.0:8765"]
